{
  "$defs": {
    "DegradedAttribute": {
      "additionalProperties": false,
      "description": "One specific way an entity loses fidelity. Vague entries are worse than none.",
      "properties": {
        "attribute": {
          "description": "Canonical attribute path, e.g. 'shared_appearance.privacy'.",
          "title": "Attribute",
          "type": "string"
        },
        "reason": {
          "description": "Why the target cannot represent it faithfully.",
          "title": "Reason",
          "type": "string"
        },
        "source_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Value"
        },
        "target_behaviour": {
          "description": "What will actually happen on the target instead. This is the sentence the customer reads in the fidelity report, so write it for them.",
          "title": "Target Behaviour",
          "type": "string"
        }
      },
      "required": [
        "attribute",
        "reason",
        "target_behaviour"
      ],
      "title": "DegradedAttribute",
      "type": "object"
    },
    "FidelityAssessment": {
      "additionalProperties": false,
      "description": "A fidelity claim, with the evidence required to make it.\n\nThe guardrail 'never mark an entity LOSSLESS by default' is enforced here\nrather than left to connector authors' discipline.",
      "properties": {
        "assessed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessed At"
        },
        "assessed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Connector id or mapping-rule id that made this claim.",
          "title": "Assessed By"
        },
        "degraded_attributes": {
          "items": {
            "$ref": "#/$defs/DegradedAttribute"
          },
          "title": "Degraded Attributes",
          "type": "array"
        },
        "level": {
          "$ref": "#/$defs/FidelityLevel",
          "default": "DEGRADED"
        },
        "manual_effort_minutes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Estimated manual remediation effort. Required for UNMAPPABLE so the assessment report can total up the human cost of a migration.",
          "title": "Manual Effort Minutes"
        },
        "rationale": {
          "default": "Not yet assessed: no fidelity rule has evaluated this entity.",
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "unmapped_source_attributes": {
          "description": "Keys present in source_ref.native_attributes with no canonical home.",
          "items": {
            "type": "string"
          },
          "title": "Unmapped Source Attributes",
          "type": "array"
        }
      },
      "title": "FidelityAssessment",
      "type": "object"
    },
    "FidelityLevel": {
      "description": "How faithfully an entity survives the transform. See docs/fidelity-taxonomy.md.",
      "enum": [
        "LOSSLESS",
        "DEGRADED",
        "UNMAPPABLE"
      ],
      "title": "FidelityLevel",
      "type": "string"
    },
    "Platform": {
      "description": "Platforms the canonical model can describe.\n\nAdding a member here does not imply a working connector exists; the\nconnector's capability manifest is the authority on what is actually\nsupported.",
      "enum": [
        "cisco.cucm",
        "cisco.unity_connection",
        "cisco.uccx",
        "cisco.ucce",
        "avaya.aura",
        "avaya.aura_messaging",
        "microsoft.sfb_server",
        "microsoft.teams",
        "slack",
        "genesys.cloud",
        "mitel",
        "generic.sip",
        "reference.memorypbx"
      ],
      "title": "Platform",
      "type": "string"
    },
    "RingSetting": {
      "enum": [
        "RING",
        "FLASH_ONLY",
        "BEEP_ONLY",
        "DISABLE",
        "RING_ONCE"
      ],
      "title": "RingSetting",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Where this entity came from. Populated by ``Extract``, never by ``Apply``.",
      "properties": {
        "api_surface": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Which API produced this, e.g. 'AXL:getPhone', 'Graph:/users', 'SAT:display station'. Needed to reproduce an extraction.",
          "title": "Api Surface"
        },
        "extracted_at": {
          "format": "date-time",
          "title": "Extracted At",
          "type": "string"
        },
        "instance_id": {
          "description": "Cluster / tenant / workspace identifier. Distinguishes two CUCM clusters or two Teams tenants belonging to the same customer.",
          "title": "Instance Id",
          "type": "string"
        },
        "native_attributes": {
          "additionalProperties": true,
          "description": "Raw source attributes retained verbatim, including ones the canonical model does not map. Nothing is silently discarded; the assessment engine reports on the unmapped remainder.",
          "title": "Native Attributes",
          "type": "object"
        },
        "native_key": {
          "description": "Vendor primary key: AXL pkid, Graph objectId, SMGR uid, Slack user id.",
          "title": "Native Key",
          "type": "string"
        },
        "native_type": {
          "description": "Vendor's own name for the object type, e.g. 'Phone', 'CsOnlineUser', 'station'. Kept verbatim for audit.",
          "title": "Native Type",
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/Platform"
        },
        "raw_sql_used": {
          "default": false,
          "description": "True if this object was read via an untyped escape hatch such as AXL executeSQLQuery. Surfaced in the audit log because raw SQL bypasses the vendor's own schema guarantees.",
          "title": "Raw Sql Used",
          "type": "boolean"
        }
      },
      "required": [
        "platform",
        "instance_id",
        "native_type",
        "native_key"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TargetRef": {
      "additionalProperties": false,
      "description": "Where this entity landed. Populated by ``Apply`` only.",
      "properties": {
        "applied_at": {
          "format": "date-time",
          "title": "Applied At",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ties this write back to a run and an audit record.",
          "title": "Correlation Id"
        },
        "dry_run": {
          "default": true,
          "description": "True when the reference was produced by a dry run and therefore describes an object that does not exist on the target.",
          "title": "Dry Run",
          "type": "boolean"
        },
        "instance_id": {
          "title": "Instance Id",
          "type": "string"
        },
        "native_key": {
          "title": "Native Key",
          "type": "string"
        },
        "native_type": {
          "title": "Native Type",
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/Platform"
        }
      },
      "required": [
        "platform",
        "instance_id",
        "native_type",
        "native_key"
      ],
      "title": "TargetRef",
      "type": "object"
    },
    "TransformLogEntry": {
      "additionalProperties": false,
      "description": "One recorded step in an entity's journey. Append-only; never rewritten.",
      "properties": {
        "actor": {
          "description": "Connector id, rule id, or user principal that acted.",
          "title": "Actor",
          "type": "string"
        },
        "after": {
          "default": null,
          "title": "After"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "before": {
          "default": null,
          "title": "Before"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "fidelity_impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/FidelityLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operation": {
          "$ref": "#/$defs/TransformOperation"
        },
        "rule_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mapping-profile rule that caused this, if any.",
          "title": "Rule Ref"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "actor",
        "summary"
      ],
      "title": "TransformLogEntry",
      "type": "object"
    },
    "TransformOperation": {
      "enum": [
        "EXTRACT",
        "NORMALISE",
        "MAP",
        "OVERRIDE",
        "APPLY",
        "ROLLBACK",
        "QUARANTINE"
      ],
      "title": "TransformOperation",
      "type": "string"
    }
  },
  "$id": "https://schemas.ucm-bridge.dev/entities/Line.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A directory number as it appears on a device or profile.\n\nDistinct from Extension: an Extension is the dialable string; a Line is one\nappearance of it, with its own label, forwarding, and ring behaviour.",
  "properties": {
    "alerting_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alerting Name"
    },
    "busy_trigger": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Busy Trigger"
    },
    "calling_permission_ref": {
      "anyOf": [
        {
          "description": "canonical_id of another entity in the same snapshot (a reference).",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calling Permission Ref"
    },
    "canonical_id": {
      "description": "canonical_id of another entity in the same snapshot (a reference).",
      "minLength": 1,
      "title": "Canonical Id",
      "type": "string"
    },
    "checksum": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Digest of extraction-scoped content. Set by seal(); verified on load.",
      "title": "Checksum"
    },
    "device_ref": {
      "anyOf": [
        {
          "description": "canonical_id of another entity in the same snapshot (a reference).",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Device Ref"
    },
    "directory_number": {
      "title": "Directory Number",
      "type": "string"
    },
    "display_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Caller ID name presented on internal calls.",
      "title": "Display Name"
    },
    "e164_ref": {
      "anyOf": [
        {
          "description": "canonical_id of another entity in the same snapshot (a reference).",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "E164 Ref"
    },
    "extension_ref": {
      "anyOf": [
        {
          "description": "canonical_id of another entity in the same snapshot (a reference).",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extension Ref"
    },
    "external_presentation_number_ref": {
      "anyOf": [
        {
          "description": "canonical_id of another entity in the same snapshot (a reference).",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Presentation Number Ref"
    },
    "fidelity": {
      "$ref": "#/$defs/FidelityAssessment"
    },
    "forwarding_rule_refs": {
      "items": {
        "description": "canonical_id of another entity in the same snapshot (a reference).",
        "minLength": 1,
        "type": "string"
      },
      "title": "Forwarding Rule Refs",
      "type": "array"
    },
    "kind": {
      "const": "Line",
      "default": "Line",
      "title": "Kind",
      "type": "string"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "line_index": {
      "default": 1,
      "description": "Button position on the device.",
      "minimum": 1,
      "title": "Line Index",
      "type": "integer"
    },
    "max_num_calls": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Num Calls"
    },
    "owner_ref": {
      "anyOf": [
        {
          "description": "canonical_id of another entity in the same snapshot (a reference).",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner Ref"
    },
    "partition_ref": {
      "anyOf": [
        {
          "description": "canonical_id of another entity in the same snapshot (a reference).",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Partition Ref"
    },
    "ring_setting_active": {
      "$ref": "#/$defs/RingSetting",
      "default": "RING"
    },
    "ring_setting_idle": {
      "$ref": "#/$defs/RingSetting",
      "default": "RING"
    },
    "shared_appearance_ref": {
      "anyOf": [
        {
          "description": "canonical_id of another entity in the same snapshot (a reference).",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shared Appearance Ref"
    },
    "site_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Owning site. Directory numbers are only unique within a site on most on-prem estates, so the natural key is usually site + number.",
      "title": "Site Code"
    },
    "source_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tags": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Operator-assigned labels: wave, owner, exception id.",
      "title": "Tags",
      "type": "object"
    },
    "target_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/TargetRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "transform_log": {
      "items": {
        "$ref": "#/$defs/TransformLogEntry"
      },
      "title": "Transform Log",
      "type": "array"
    },
    "voicemail_box_ref": {
      "anyOf": [
        {
          "description": "canonical_id of another entity in the same snapshot (a reference).",
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Voicemail Box Ref"
    },
    "voicemail_profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Voicemail Profile"
    }
  },
  "required": [
    "canonical_id",
    "directory_number"
  ],
  "title": "Line",
  "type": "object",
  "x-canonical-model-version": "1.0.0"
}
